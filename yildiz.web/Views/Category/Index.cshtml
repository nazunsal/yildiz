@model List<yildiz.entities.Concrete.Category>

<h2>Kategoriler</h2>

<a asp-action="Add" class="btn btn-success mb-3">
    Yeni Kategori Ekle
</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Kategori Adı</th>
            <th>İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryId</td>
                <td>@item.CategoryName</td>
                <td>
                    <a asp-action="Update"
                       asp-route-id="@item.CategoryId"
                       class="btn btn-warning">
                        Güncelle
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@item.CategoryId"
                          method="post"
                          style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>