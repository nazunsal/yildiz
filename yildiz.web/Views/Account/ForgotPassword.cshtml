@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-header">
            <span>YILDIZ MAĞAZA</span>

            <h1>Şifremi Unuttum</h1>

            <p>
                Şifreni yenilemek için kullanıcı adı ve e-posta adresini gir.
            </p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="forgot-error">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            <div class="forgot-field">
                <label>Kullanıcı Adı</label>

                <input type="text"
                       name="username"
                       required />
            </div>

            <div class="forgot-field">
                <label>E-posta</label>

                <input type="email"
                       name="email"
                       required />
            </div>

            <button type="submit"
                    class="forgot-button">
                Devam Et
            </button>

        </form>

        <div class="forgot-links">

            <a asp-controller="Account"
               asp-action="Login">
                Giriş Yap
            </a>

        </div>

    </div>

</div>

<style>
    .forgot-page {
        max-width: 600px;
        margin: 60px auto;
        padding: 0 25px;
    }

    .forgot-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    .forgot-header {
        margin-bottom: 30px;
    }

        .forgot-header span {
            color: #f5a800;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .forgot-header h1 {
            color: #111827;
            font-size: 44px;
            font-weight: 800;
            margin: 8px 0;
        }

        .forgot-header p {
            color: #64748b;
            font-size: 17px;
            margin: 0;
        }

    .forgot-field {
        margin-bottom: 20px;
    }

        .forgot-field label {
            display: block;
            color: #111827;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .forgot-field input {
            width: 100%;
            box-sizing: border-box;
            padding: 14px 16px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-size: 16px;
            font-family: inherit;
        }

            .forgot-field input:focus {
                outline: none;
                border-color: #fbbf24;
            }

    .forgot-button {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 12px;
        background: #fbbf24;
        color: #111827;
        font-size: 18px;
        font-weight: 800;
        cursor: pointer;
    }

        .forgot-button:hover {
            background: #f59e0b;
        }

    .forgot-links {
        text-align: center;
        margin-top: 25px;
    }

        .forgot-links a {
            color: #111827 !important;
            text-decoration: none !important;
            font-weight: 600;
        }

            .forgot-links a:hover {
                color: #f59e0b !important;
            }

    .forgot-error {
        background: #fee2e2;
        color: #b91c1c;
        padding: 13px 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }
</style>