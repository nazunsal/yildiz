@{
    ViewData["Title"] = "Kayıt Ol";
}

<style>
    .register-page {
        min-height: 650px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 60px 20px;
    }

    .register-card {
        width: 100%;
        max-width: 500px;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    .register-header {
        text-align: center;
        margin-bottom: 30px;
    }

        .register-header span {
            display: block;
            color: #f5a800;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .register-header h1 {
            margin: 0 0 10px 0;
            font-size: 42px;
            color: #111827;
        }

        .register-header p {
            color: #64748b;
            margin: 0;
        }

    .register-field {
        margin-bottom: 20px;
    }

        .register-field label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #111827;
        }

        .register-field input {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-size: 16px;
            box-sizing: border-box;
        }

            .register-field input:focus {
                outline: none;
                border-color: #f5b800;
            }

    .register-button {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: #f5b800;
        color: #111827;
        font-size: 17px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 5px;
    }

        .register-button:hover {
            background: #e5a900;
        }

    .register-links {
        margin-top: 25px;
        text-align: center;
    }

        .register-links a {
            color: #111827 !important;
            text-decoration: none !important;
            font-weight: 600;
        }

            .register-links a:hover {
                color: #f5a800 !important;
            }

    .register-error {
        background: #fee2e2;
        color: #b91c1c;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        text-align: center;
    }
</style>

<div class="register-page">

    <div class="register-card">

        <div class="register-header">

            <span>YILDIZ MAĞAZA</span>

            <h1>Kayıt Ol</h1>

            <p>
                Yıldız'a katıl ve alışverişe başla.
            </p>

        </div>

        @if (ViewBag.Error != null)
        {
            <div class="register-error">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <div class="register-field">

                <label>Ad Soyad</label>

                <input type="text"
                       name="name"
                       placeholder="Ad soyad"
                       required />

            </div>

            <div class="register-field">

                <label>Kullanıcı Adı</label>

                <input type="text"
                       name="username"
                       placeholder="Kullanıcı adı"
                       required />

            </div>

            <div class="register-field">

                <label>E-posta</label>

                <input type="email"
                       name="email"
                       placeholder="ornek@mail.com"
                       required />

            </div>

            <div class="register-field">

                <label>Şifre</label>

                <input type="password"
                       name="password"
                       placeholder="Şifre"
                       minlength="6"
                       required />

                <small>
                    Şifreniz en az 6 karakter olmalıdır.
                </small>

            </div>

            <div class="register-field">

                <label>Şifre Tekrar</label>

                <input type="password"
                       name="confirmPassword"
                       placeholder="Şifreyi tekrar gir"
                       minlength="6"
                       required />

            </div>

            <button type="submit"
                    class="register-button">

                Kayıt Ol

            </button>

        </form>

        <div class="register-links">

            <a asp-controller="Account"
               asp-action="Login">

                Zaten hesabın var mı? Giriş Yap

            </a>

        </div>

    </div>

</div>