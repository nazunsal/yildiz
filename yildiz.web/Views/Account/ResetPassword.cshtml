@{
    ViewData["Title"] = "Şifre Yenile";
}

<div class="reset-page">

    <div class="reset-card">

        <div class="reset-header">
            <span>YILDIZ MAĞAZA</span>

            <h1>Yeni Şifre</h1>

            <p>
                Hesabın için yeni bir şifre belirle.
            </p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="reset-error">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            <div class="reset-field">
                <label>Yeni Şifre</label>

                <input type="password"
                       name="password"
                       required />
            </div>

            <div class="reset-field">
                <label>Yeni Şifre Tekrar</label>

                <input type="password"
                       name="confirmPassword"
                       required />
            </div>

            <button type="submit"
                    class="reset-button">
                Şifreyi Değiştir
            </button>

        </form>

    </div>

</div>

<style>
    .reset-page {
        max-width: 600px;
        margin: 60px auto;
        padding: 0 25px;
    }

    .reset-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    .reset-header {
        margin-bottom: 30px;
    }

        .reset-header span {
            color: #f5a800;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .reset-header h1 {
            color: #111827;
            font-size: 44px;
            font-weight: 800;
            margin: 8px 0;
        }

        .reset-header p {
            color: #64748b;
            font-size: 17px;
            margin: 0;
        }

    .reset-field {
        margin-bottom: 20px;
    }

        .reset-field label {
            display: block;
            color: #111827;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .reset-field input {
            width: 100%;
            box-sizing: border-box;
            padding: 14px 16px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-size: 16px;
            font-family: inherit;
        }

            .reset-field input:focus {
                outline: none;
                border-color: #fbbf24;
            }

    .reset-button {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 12px;
        background: #fbbf24;
        color: #111827;
        font-size: 18px;
        font-weight: 800;
        cursor: pointer;
    }

        .reset-button:hover {
            background: #f59e0b;
        }

    .reset-error {
        background: #fee2e2;
        color: #b91c1c;
        padding: 13px 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }
</style>