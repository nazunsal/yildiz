@{
    ViewData["Title"] = "Şifre Yenile";
}

<div class="reset-page">

    <div class="reset-card">

        <div class="reset-icon">
            🔐
        </div>

        <h2>Şifre Yenile</h2>

        <p class="reset-description">
            Hesabınız için yeni bir şifre belirleyin.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="token"
                   value="@ViewBag.Token" />

            <div class="form-group">

                <label for="password">
                    Yeni Şifre
                </label>

                <input id="password"
                       type="password"
                       name="password"
                       placeholder="Yeni şifrenizi girin"
                       minlength="6"
                       required />

                <small>
                    Şifreniz en az 6 karakter olmalıdır.
                </small>

            </div>

            <div class="form-group">

                <label for="confirmPassword">
                    Yeni Şifre Tekrar
                </label>

                <input id="confirmPassword"
                       type="password"
                       name="confirmPassword"
                       placeholder="Yeni şifrenizi tekrar girin"
                       minlength="6"
                       required />

            </div>

            <button type="submit" class="reset-button">
                Şifreyi Yenile
            </button>

        </form>

        <div class="account-link">

            <a asp-controller="Account"
               asp-action="Login">
                Giriş Yap
            </a>

        </div>

    </div>

</div>

<style>

    .reset-page {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px 20px;
    }

    .reset-card {
        width: 100%;
        max-width: 480px;
        padding: 42px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    .reset-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        border-radius: 50%;
        background: #fff4cc;
    }

    .reset-card h2 {
        margin: 0;
        text-align: center;
        font-size: 34px;
        font-weight: 600;
        color: #111827;
    }

    .reset-description {
        margin: 10px 0 32px;
        text-align: center;
        color: #64748b;
        font-size: 16px;
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #111827;
            font-size: 16px;
            font-weight: 600;
        }

        .form-group input {
            width: 100%;
            height: 56px;
            padding: 0 16px;
            box-sizing: border-box;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            background: #ffffff;
            color: #111827;
            font-size: 16px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-group input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
            }

            .form-group input::placeholder {
                color: #94a3b8;
            }

        .form-group small {
            display: block;
            margin-top: 7px;
            color: #64748b;
            font-size: 13px;
        }

    .reset-button {
        width: 100%;
        height: 54px;
        margin-top: 5px;
        border: none;
        border-radius: 10px;
        background: #2563eb;
        color: #ffffff;
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

        .reset-button:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

        .reset-button:active {
            transform: translateY(0);
        }

    .error-message {
        margin-bottom: 22px;
        padding: 13px 15px;
        border-radius: 9px;
        background: #fee2e2;
        color: #b91c1c;
        font-size: 14px;
    }

    .account-link {
        margin-top: 24px;
        text-align: center;
    }

        .account-link a {
            color: #2563eb;
            font-size: 16px;
            font-weight: 500;
            text-decoration: underline;
        }

            .account-link a:hover {
                color: #1d4ed8;
            }

    @@media (max-width: 576px) {

        .reset-page {
            padding: 30px 15px;
        }

        .reset-card {
            padding: 30px 22px;
        }

            .reset-card h2 {
                font-size: 29px;
            }
    }

</style>