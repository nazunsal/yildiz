@model IEnumerable<yildiz.web.Models.CartProduct>

@{
    ViewData["Title"] = "Sepetim";
    var total = Model.Sum(x => x.Product.Price * x.Quantity);
}

<div class="cart-page">

    <div class="cart-header">
        <span>YILDIZ MAĞAZA</span>
        <h1>Sepetim</h1>
        <p>Sepetindeki ürünleri kontrol et.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="cart-empty">

            <div class="cart-empty-icon">
                🛒
            </div>

            <h2>Sepetin boş</h2>

            @if (Context.Session.GetString("IsLoggedIn") != "true")
            {
                <p>
                    Sepete ürün eklemek için önce giriş yapmanız gerekiyor.
                </p>

                <a asp-controller="Account"
                   asp-action="Login"
                   asp-route-returnUrl="/Cart"
                   class="continue-shopping">
                    Giriş Yap
                </a>
            }
            else
            {
                <p>
                    Henüz sepetine bir ürün eklemedin.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="continue-shopping">
                    Alışverişe Başla
                </a>
            }

        </div>
    }
    else
    {
        <div class="cart-layout">

            <div class="cart-products">

                @foreach (var item in Model)
                {
                    <div class="cart-item">

                        <div class="cart-item-info">

                            <h3>
                                @item.Product.Name
                            </h3>

                            <p>
                                Birim fiyat:
                                <strong>
                                    @item.Product.Price.ToString("N2") ₺
                                </strong>
                            </p>

                        </div>

                        <div class="cart-item-actions">

                            <div class="quantity-control">

                                <a asp-controller="Cart"
                                   asp-action="Decrease"
                                   asp-route-id="@item.Product.ProductId"
                                   class="quantity-button">
                                    −
                                </a>

                                <span class="quantity">
                                    @item.Quantity
                                </span>

                                <a asp-controller="Cart"
                                   asp-action="Increase"
                                   asp-route-id="@item.Product.ProductId"
                                   class="quantity-button">
                                    +
                                </a>

                            </div>

                            <div class="cart-item-total">
                                @((item.Product.Price * item.Quantity).ToString("N2")) ₺
                            </div>

                            <a asp-controller="Cart"
                               asp-action="Remove"
                               asp-route-id="@item.Product.ProductId"
                               class="remove-button">
                                🗑 Sil
                            </a>

                        </div>

                    </div>
                }

            </div>

            <div class="cart-summary">

                <h2>Sipariş Özeti</h2>

                <div class="summary-line">
                    <span>Ürün Sayısı</span>
                    <strong>@Model.Sum(x => x.Quantity)</strong>
                </div>

                <div class="summary-line total-line">
                    <span>Toplam</span>
                    <strong>
                        @total.ToString("N2") ₺
                    </strong>
                </div>

                <a asp-controller="Checkout"
                   asp-action="Index"
                   class="checkout-button">
                    Ödemeye Geç
                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="continue-shopping">
                    Alışverişe Devam Et
                </a>

            </div>

        </div>
    }

</div>

<style>

    .cart-page {
        max-width: 1200px;
        margin: 50px auto;
        padding: 0 25px;
    }

    .cart-header {
        margin-bottom: 35px;
    }

        .cart-header span {
            color: #f59e0b;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .cart-header h1 {
            color: #111827;
            font-size: 52px;
            font-weight: 800;
            margin: 8px 0;
        }

        .cart-header p {
            color: #6b7280;
            font-size: 18px;
        }

    .cart-empty {
        background: white;
        border-radius: 20px;
        padding: 70px 30px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
    }

    .cart-empty-icon {
        font-size: 65px;
        margin-bottom: 20px;
    }

    .cart-empty h2 {
        color: #111827;
        font-size: 30px;
        margin-bottom: 10px;
    }

    .cart-empty p {
        color: #6b7280;
        font-size: 17px;
        margin-bottom: 25px;
    }

    .continue-shopping {
        display: inline-block;
        padding: 13px 24px;
        border-radius: 10px;
        background: #fbbf24;
        color: #111827 !important;
        text-decoration: none !important;
        font-weight: 700;
        transition: 0.2s;
    }

        .continue-shopping:hover {
            background: #f59e0b;
        }

    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 30px;
        align-items: start;
    }

    .cart-products {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .cart-item {
        background: white;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
    }

    .cart-item-info h3 {
        color: #111827;
        margin: 0 0 10px 0;
        font-size: 21px;
    }

    .cart-item-info p {
        color: #6b7280;
        margin: 0;
    }

    .cart-item-actions {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .quantity-control {
        display: flex;
        align-items: center;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        overflow: hidden;
    }

    .quantity-button {
        width: 38px;
        height: 38px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        color: #111827;
        font-size: 20px;
        font-weight: 700;
    }

        .quantity-button:hover {
            background: #f3f4f6;
        }

    .quantity {
        width: 40px;
        text-align: center;
        font-weight: 700;
    }

    .cart-item-total {
        font-size: 18px;
        font-weight: 800;
        color: #111827;
        min-width: 100px;
        text-align: right;
    }

    .remove-button {
        color: #dc2626;
        text-decoration: none;
        font-weight: 600;
    }

        .remove-button:hover {
            color: #991b1b;
        }

    .cart-summary {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
        position: sticky;
        top: 20px;
    }

        .cart-summary h2 {
            margin-top: 0;
            color: #111827;
            margin-bottom: 25px;
        }

    .summary-line {
        display: flex;
        justify-content: space-between;
        padding: 15px 0;
        color: #6b7280;
        border-bottom: 1px solid #e5e7eb;
    }

        .summary-line strong {
            color: #111827;
        }

    .total-line {
        margin-top: 10px;
        padding-top: 20px;
        border-top: 2px solid #111827;
        border-bottom: none;
        font-size: 21px;
        font-weight: 800;
    }

    .checkout-button {
        display: block;
        width: 100%;
        padding: 15px;
        margin-top: 20px;
        border-radius: 12px;
        background: #fbbf24;
        color: #111827 !important;
        text-align: center;
        text-decoration: none !important;
        font-size: 17px;
        font-weight: 800;
        box-sizing: border-box;
    }

        .checkout-button:hover {
            background: #f59e0b;
        }

    .cart-summary .continue-shopping {
        display: block;
        text-align: center;
        margin-top: 12px;
        background: #f3f4f6;
    }

        .cart-summary .continue-shopping:hover {
            background: #e5e7eb;
        }

    @@media (max-width: 850px) {

        .cart-layout {
            grid-template-columns: 1fr;
        }

        .cart-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .cart-item-actions {
            width: 100%;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .cart-header h1 {
            font-size: 40px;
        }
    }

</style>