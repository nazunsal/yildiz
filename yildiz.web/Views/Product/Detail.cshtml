@model yildiz.entities.Concrete.Product

@{
    ViewData["Title"] = Model.Name;
}

<style>
    .product-detail-page {
        padding: 50px 0 80px;
    }

    .product-detail {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        align-items: center;
        background: white;
        padding: 40px;
        border-radius: 24px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    .product-detail-image {
        height: 500px;
        border-radius: 20px;
        overflow: hidden;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .product-detail-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .product-placeholder {
        font-size: 100px;
    }

    .product-detail-info span {
        display: block;
        color: #f5a800;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .product-detail-info h1 {
        font-size: 48px;
        color: #111827;
        margin: 0 0 20px;
        font-weight: 800;
    }

    .product-description {
        color: #64748b;
        font-size: 18px;
        line-height: 1.7;
        margin-bottom: 25px;
    }

    .product-price {
        font-size: 34px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 20px;
    }

    .product-stock {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 8px;
        background: #dcfce7;
        color: #166534;
        font-weight: 700;
        margin-bottom: 25px;
    }

        .product-stock.out {
            background: #fee2e2;
            color: #b91c1c;
        }

    .detail-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .add-cart-button {
        display: inline-block;
        background: #fbbf24;
        color: #111827;
        padding: 15px 25px;
        border-radius: 11px;
        text-decoration: none;
        font-size: 17px;
        font-weight: 800;
    }

        .add-cart-button:hover {
            background: #f59e0b;
            color: #111827;
        }

    .back-button {
        display: inline-block;
        background: #111827;
        color: white;
        padding: 15px 25px;
        border-radius: 11px;
        text-decoration: none;
        font-size: 17px;
        font-weight: 700;
    }

        .back-button:hover {
            background: #374151;
            color: white;
        }

    @@media (max-width: 800px) {
        .product-detail {
            grid-template-columns: 1fr;
            padding: 25px;
        }

        .product-detail-image {
            height: 350px;
        }

        .product-detail-info h1 {
            font-size: 38px;
        }
    }
</style>

<div class="product-detail-page">

    <div class="container">

        <div class="product-detail">

            <div class="product-detail-image">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name" />
                }
                else
                {
                    <div class="product-placeholder">
                        ⭐
                    </div>
                }

            </div>

            <div class="product-detail-info">

                <span>YILDIZ MAĞAZA</span>

                <h1>
                    @Model.Name
                </h1>

                <div class="product-description">
                    @Model.Description
                </div>

                <div class="product-price">
                    @Model.Price.ToString("N2") ₺
                </div>

                @if (Model.Stock > 0)
                {
                    <div class="product-stock">
                        Stokta: @Model.Stock adet
                    </div>
                }
                else
                {
                    <div class="product-stock out">
                        Stokta yok
                    </div>
                }

                <div class="detail-actions">

                    @if (Model.Stock > 0)
                    {
                        <a asp-controller="Cart"
                           asp-action="Add"
                           asp-route-id="@Model.ProductId"
                           class="add-cart-button">

                            🛒 Sepete Ekle

                        </a>
                    }

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="back-button">

                        ← Ürünlere Dön

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>