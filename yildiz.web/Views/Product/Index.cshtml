@model IEnumerable<yildiz.entities.Concrete.Product>

@{
    ViewData["Title"] = "Ürünler";
}

<style>
    .products-page {
        padding: 60px 0 100px;
        min-height: 70vh;
    }

    .products-header {
        margin-bottom: 25px;
    }

    .products-label {
        display: block;
        color: #f59e0b;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .products-header h1 {
        color: #111827;
        font-size: 48px;
        font-weight: 800;
        margin: 0 0 10px;
    }

    .products-header p {
        color: #6b7280;
        font-size: 18px;
        margin: 0;
    }

    .product-search {
        display: flex;
        gap: 10px;
        margin-bottom: 40px;
    }

        .product-search input {
            flex: 1;
            padding: 14px 17px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-size: 16px;
            box-sizing: border-box;
        }

            .product-search input:focus {
                outline: none;
                border-color: #f59e0b;
            }

        .product-search button {
            padding: 14px 22px;
            border: none;
            border-radius: 10px;
            background: #111827;
            color: white;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
        }

            .product-search button:hover {
                background: #f59e0b;
                color: #111827;
            }

    .products-grid {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        gap: 25px !important;
        width: 100%;
    }

    .product-card {
        background: #ffffff !important;
        border-radius: 18px !important;
        overflow: hidden !important;
        border: 1px solid #e5e7eb !important;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06) !important;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12) !important;
        }

    .product-image {
        width: 100% !important;
        height: 250px !important;
        background: #f3f4f6 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        overflow: hidden !important;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .product-placeholder {
        font-size: 65px;
    }

    .product-info {
        padding: 25px !important;
    }

    .product-category {
        color: #f59e0b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .product-info h2 {
        color: #111827;
        font-size: 24px;
        font-weight: 700;
        margin: 8px 0 10px;
    }

    .product-description {
        color: #6b7280;
        font-size: 15px;
        line-height: 1.6;
        min-height: 48px;
        margin-bottom: 20px;
    }

    .product-bottom {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 15px;
    }

    .product-price {
        color: #111827;
        font-size: 21px;
        font-weight: 800;
    }

    .product-button {
        display: inline-block;
        background: #111827 !important;
        color: #ffffff !important;
        text-decoration: none !important;
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .product-button:hover {
            background: #fbbf24 !important;
            color: #111827 !important;
        }

    .empty-products {
        background: #ffffff;
        border-radius: 18px;
        padding: 80px 20px;
        text-align: center;
        border: 1px solid #e5e7eb;
    }

    .empty-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }

    .search-result {
        color: #64748b;
        margin-bottom: 25px;
        font-size: 15px;
    }

    @@media (max-width: 992px) {
        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }

    @@media (max-width: 768px) {
        .products-page {
            padding: 40px 15px 70px;
        }

        .products-header h1 {
            font-size: 38px;
        }

        .products-grid {
            grid-template-columns: 1fr !important;
        }

        .product-search {
            flex-direction: column;
        }

            .product-search button {
                width: 100%;
            }
    }
</style>

<div class="products-page">

    <div class="container">

        <div class="products-header">

            <span class="products-label">
                YILDIZ MAĞAZA
            </span>

            <h1>
                Ürünler
            </h1>

            <p>
                İhtiyacın olan ürünleri keşfet.
            </p>

        </div>

        <form asp-controller="Product"
              asp-action="Index"
              method="get"
              class="product-search">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Ürün ara..." />

            <button type="submit">
                🔍 Ara
            </button>

        </form>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
        {
            <div class="search-result">
                "@ViewBag.Search" için arama sonuçları
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="products-grid">

                @foreach (var item in Model)
                {
                    <div class="product-card">

                        <div class="product-image">

                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl) &&
                                 item.ImageUrl.StartsWith("http"))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Name" />
                            }
                            else
                            {
                                <div class="product-placeholder">
                                    ⭐
                                </div>
                            }

                        </div>

                        <div class="product-info">

                            <span class="product-category">
                                Ürün
                            </span>

                            <h2>
                                @item.Name
                            </h2>

                            <p class="product-description">
                                @item.Description
                            </p>

                            <div class="product-bottom">

                                <span class="product-price">
                                    @item.Price.ToString("N2") ₺
                                </span>

                                <a asp-controller="Product"
                                   asp-action="Detail"
                                   asp-route-id="@item.ProductId"
                                   class="product-button">

                                    İncele

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-products">

                <div class="empty-icon">
                    🔍
                </div>

                <h2>
                    Ürün bulunamadı
                </h2>

                <p>
                    Aradığın ürüne ait bir sonuç bulunamadı.
                </p>

            </div>
        }

    </div>

</div>